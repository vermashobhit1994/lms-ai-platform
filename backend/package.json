{
  "name": "LMS-AI backend",
  "version": "1.0.0",
  "description": "backend API for Vertexon LMS-AI(Learning Management system with AI Tutor) platform",
  "main": "src/server.ts",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:create-empty": "tsx src/db/scripts/01_create_empty_db.ts --ignoreConfig",
    "db:migrate": "tsx src/db/scripts/02_run_db_migrations.ts --ignoreConfig",
    "db:seed": "tsx src/db/scripts/03_run_db_seeders.ts --ignoreConfig",
    "db:create-admin-user": "tsx src/db/scripts/04_create_admin_user.ts --ignoreConfig"
  },
  "keywords": [
    "lms",
    "education",
    "backend",
    "rbac"
  ],
  "author": "Vertex Learning Technologies Pvt. Ltd.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "jose": "^6.2.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
